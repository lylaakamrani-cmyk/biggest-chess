# ui/kv/home.kv
<HomeScreen>:
    BoxLayout:
        orientation: 'vertical'
        padding: dp(10)
        spacing: dp(5)
        
        Label:
            text: '♟ Chess Master Pro'
            font_size: dp(28)
            color: (1, 1, 0.6, 1)
            bold: True
            size_hint_y: 0.08
            
        Label:
            text: 'Professional Chess Game'
            font_size: dp(14)
            color: (0.7, 0.7, 0.7, 1)
            size_hint_y: 0.05
            
        GridLayout:
            cols: 2
            spacing: dp(8)
            size_hint_y: 0.6
            
            Button:
                text: '🎮 Local'
                font_size: dp(16)
                size_hint_y: None
                height: dp(48)
                background_normal: ''
                background_color: (0.2, 0.2, 0.35, 1)
                on_release: app.root.current = 'local'
                
            Button:
                text: '🤖 VS AI'
                font_size: dp(16)
                size_hint_y: None
                height: dp(48)
                background_normal: ''
                background_color: (0.2, 0.2, 0.35, 1)
                on_release: app.root.current = 'board'
                
            Button:
                text: '🌐 Online'
                font_size: dp(16)
                size_hint_y: None
                height: dp(48)
                background_normal: ''
                background_color: (0.2, 0.2, 0.35, 1)
                on_release: app.root.current = 'online'
                
            Button:
                text: '🏆 Tournament'
                font_size: dp(16)
                size_hint_y: None
                height: dp(48)
                background_normal: ''
                background_color: (0.2, 0.2, 0.35, 1)
                on_release: app.root.current = 'board'
                
            Button:
                text: '📊 Analysis'
                font_size: dp(16)
                size_hint_y: None
                height: dp(48)
                background_normal: ''
                background_color: (0.2, 0.2, 0.35, 1)
                on_release: app.root.current = 'board'
                
            Button:
                text: '👤 Profile'
                font_size: dp(16)
                size_hint_y: None
                height: dp(48)
                background_normal: ''
                background_color: (0.2, 0.2, 0.35, 1)
                on_release: app.root.current = 'profile'
                
            Button:
                text: '🛒 Shop'
                font_size: dp(16)
                size_hint_y: None
                height: dp(48)
                background_normal: ''
                background_color: (0.2, 0.2, 0.35, 1)
                on_release: app.root.current = 'shop'
                
            Button:
                text: '⚙️ Settings'
                font_size: dp(16)
                size_hint_y: None
                height: dp(48)
                background_normal: ''
                background_color: (0.2, 0.2, 0.35, 1)
                on_release: app.root.current = 'settings'
                
        Widget:
            size_hint_y: 0.08
            
        Button:
            text: '🚪 Exit'
            font_size: dp(18)
            size_hint_y: None
            height: dp(40)
            background_normal: ''
            background_color: (0.6, 0.1, 0.1, 1)
            on_release: app.stop()